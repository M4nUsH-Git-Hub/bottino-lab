{
  "manifest_version": 3,
  "name": "Bottino Lab",
  "version": "1.0.0",
  "description": "Invia a Bottino Lab la domanda del quiz o le quote della pagina che stai guardando.",
  "action": {
    "default_title": "Invia a Bottino Lab",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://m4nush-git-hub.github.io/bottino-lab/*"]
}
